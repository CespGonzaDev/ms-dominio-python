# Copiar a .env para desarrollo local. NO poner valores reales en este archivo.

# --- Cosmos DB ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=skillgrow

# --- Seguridad APIM -> backend (mTLS) ---
# En local usar false. En Azure SIEMPRE true.
APIM_CERT_CHECK=false
# Huella SHA-1 del certificado de cliente de APIM (hex, sin ":")
APIM_CERT_THUMBPRINT=

# --- Integracion con MS1 (validar sesion al crear resenas) ---
CORE_API_URL=https://skillgrow-org.azure-api.net/core/v1
APIM_SUBSCRIPTION_KEY=

# --- General ---
SERVICE_NAME=ms-dominio-python
LOG_LEVEL=INFO
